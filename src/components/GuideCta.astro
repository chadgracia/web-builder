---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
const guideUrl = `https://pre-ipo.graciagroup.com/guide?src=guide-${slug}`;
---

<aside class="guide-cta">
  <p class="guide-cta-kicker">Free Guide</p>
  <p class="guide-cta-title">Inside a Pre-IPO Trade</p>
  <p class="guide-cta-text">See exactly how a private-market trade works — SPV structures, fees, red flags, and the questions to ask before you wire.</p>
  <a class="btn guide-cta-btn" href={guideUrl}>Get the Guide &rarr;</a>
</aside>

<style>
  .guide-cta {
    background: var(--surface, #faf8f3);
    border: 1px solid var(--border, #e5e0d5);
    border-top: 3px solid var(--accent, #b8925a);
    border-radius: var(--radius-lg, 10px);
    padding: 28px 32px;
    margin: 28px 0;
  }
  .guide-cta-kicker {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent, #b8925a);
    margin: 0 0 8px;
  }
  .guide-cta-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 10px;
  }
  .guide-cta-text {
    font-size: 0.95em;
    color: var(--text-secondary, var(--ink));
    margin: 0 0 16px;
  }
  .guide-cta-btn {
    display: inline-block;
  }
  @media (max-width: 640px) {
    .guide-cta { padding: 18px 20px; }
    .guide-cta-btn { display: block; text-align: center; }
  }
</style>
