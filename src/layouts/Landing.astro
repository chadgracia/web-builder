---
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Disclosure from '../components/Disclosure.astro';

interface Props {
  title: string;
  description?: string;
  tradesSrc?: string;
  indexable?: boolean;
}

const { title, description, tradesSrc = 'guide', indexable = false } = Astro.props;
const tradesUrl = `https://trades.graciagroup.com/?src=${tradesSrc}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {indexable ? <meta name="robots" content="index, follow" /> : <meta name="robots" content="noindex, nofollow" />}
    {indexable && <link rel="canonical" href={new URL(Astro.url.pathname, 'https://pre-ipo.graciagroup.com').href} />}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="stylesheet" href="https://s3.us-east-1.amazonaws.com/main.css/master.css" />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <Header tradesUrl={tradesUrl} />

    <main class="landing">
      <slot />
      <Disclosure />
    </main>
  </body>
</html>

<style>
  .landing {
    max-width: 44rem;
    margin: 0 auto;
    padding: 40px 0 64px;
  }

  @media (max-width: 640px) {
    .landing { padding: 24px 0 48px; }
  }
</style>
