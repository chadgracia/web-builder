---
import Analytics from '../components/Analytics.astro';
import Disclosure from '../components/Disclosure.astro';
interface Props {
  title: string;
  seoTitle?: string;
  heading?: string;
  description?: string;
  blurb?: string;
  sector?: string;
  slug: string;
  logo?: string;
  noShares?: boolean;
  ctaText?: string;
  topSrc?: string;
  bottomSrc?: string;
  canonical?: string;
}
const { title, seoTitle, heading, description, blurb, sector, slug, logo, noShares, topSrc, canonical } = Astro.props;
const topTradesUrl = `https://trades.graciagroup.com/?src=${topSrc ?? slug}`;
const companyName = title.split('—')[0].trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seoTitle ?? `${title} — Pre-IPO Research | Gracia Group`}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="stylesheet" href="https://s3.us-east-1.amazonaws.com/main.css/master.css" />
    <Analytics />
  </head>
  <body>
    <header class="header">
      <a class="brand" href="/">Gracia Group</a>
      <nav class="nav">
        <a class="company-btn" href="/">All Articles</a>
      </nav>
    </header>

    <main class="page">
      <div class="company-head">
        {logo && <img src={logo} alt={`${title} logo`} class="company-logo" onerror="this.style.display='none'" />}
        <h1>{heading ?? title}</h1>
      </div>
      {blurb && <p class="subtitle">{blurb}</p>}

      {!noShares && (
        <div class="cta-callout">
          <span class="cta-callout-text">Live bids &amp; offers in {companyName} are open to registered users.</span>
          <a class="btn" href={topTradesUrl}>View the trading book &rarr;</a>
        </div>
      )}

      <slot name="after-intro" />

      <article class="report">
        <slot />
      </article>

      <slot name="before-disclosure" />

      <Disclosure />
    </main>
  </body>
</html>

<style>
  .header { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .brand { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; color: var(--ink); border-bottom: none; }
  .nav { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .page { padding: 40px; }
  .company-head { display: flex; align-items: center; gap: 16px; }
  .company-logo { height: 48px; width: auto; object-fit: contain; }
  .cta-callout { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; background: #faf8f3; border-left: 4px solid var(--accent); padding: 14px 18px; border-radius: 6px; margin: 22px 0 28px; }
  .cta-callout-text { font-size: 0.98em; color: var(--ink); }
  .report :global(h2) { margin-top: 8px; }
  @media (max-width: 640px) { .page { padding: 24px; } }
</style>
